# Safe checked-in example for SDKWork Documents local development.
# Copy to `.env` or `.env.local` and replace credentials before running `pnpm dev`.

SDKWORK_DOCUMENTS_ENVIRONMENT=development
SDKWORK_DOCUMENTS_DEPLOYMENT_PROFILE=standalone
SDKWORK_DOCUMENTS_DEV_AUTH_BYPASS=true
SDKWORK_DOCUMENTS_TENANT_ID=100001
SDKWORK_DOCUMENTS_USER_ID=10
SDKWORK_DOCUMENTS_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:18084
SDKWORK_DOCUMENTS_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:18084

SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_HOST=127.0.0.1
SDKWORK_DATABASE_PORT=5432
SDKWORK_DATABASE_NAME=sdkwork_ai_dev
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_dev
SDKWORK_DATABASE_USERNAME=sdkwork_ai_dev
SDKWORK_DATABASE_PASSWORD=sdkworkdev123
SDKWORK_DATABASE_SSL_MODE=disable
SDKWORK_DATABASE_MAX_CONNECTIONS=10

# --- Deploy application identity anchor (required build and runtime input) ---
# The public application access token's `app_id`/`aud` are this installation's
# deploy application id, not a repository-owned runtime id: IAM suppresses a token
# carrying the retired runtime app id. Export the anchor on the build host before
# `pnpm workflow:materialize-client-env`, which rewrites every committed client env
# profile of the declared surfaces with it, and keep it set at runtime.
# The materializer fails, naming this variable, when it is unset or empty, so a
# build can never fall back to a compiled-in application id.
SDKWORK_DEPLOY_APPLICATION_ID=
